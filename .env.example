# ⚠️ NE JAMAIS COMMIT CE FICHIER — copiez-le vers .env
# cp .env.example .env

# Clé privée du wallet (MetaMask → Account Details → Export Private Key)
PRIVATE_KEY=0xVOTRE_CLE_PRIVEE_ICI

# URL RPC Sepolia (Alchemy ou Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/VOTRE_CLE_API

# (Optionnel) Pour vérifier le contrat sur Etherscan
ETHERSCAN_API_KEY=

# Adresse du proxy après déploiement (rempli par deploy.js)
PROXY_ADDRESS=
